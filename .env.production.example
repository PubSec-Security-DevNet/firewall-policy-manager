# Copy to /opt/firewall-manager/runtime/.env.production and set mode 0600.
# This file contains non-secret settings only. Runtime secrets are separate protected files.

# APPLICATION (required unless marked optional)
APP_PUBLIC_HOST=firewall.example.com
APP_PUBLIC_URL=https://firewall.example.com
APP_LOG_LEVEL=INFO
FIREWALL_MANAGER_IMAGE_TAG=local-build
ADMINISTRATOR_EMAIL=firewall-operations@example.com
AUDIT_RETENTION_MONTHS=6

# DATABASE (password is runtime/secrets/postgres_password)
POSTGRES_DB=firewall_manager
POSTGRES_USER=firewall

# SECRETSTORE
# The encryption key is mounted from runtime/secrets/app_secret_key, never placed in this file.
SECRET_STORE_KEY_VERSION=1

# AUTHENTICATION / SESSION SECURITY
# Configure the first OIDC provider and Platform Admin through the one-time setup screen.
# Development authentication is forced off by Compose.
AUTH_SESSION_IDLE_MINUTES=60
AUTH_SESSION_ABSOLUTE_HOURS=12

# SMTP (optional non-secret connection defaults). Configure credentials and private CA in the UI
# after bootstrap so they are encrypted by the application SecretStore.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# WORKER / SCHEDULER
SCHEDULER_INTERVAL_SECONDS=30

# OBSERVABILITY (monitoring profile only)
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3000

# TRUST / PROXY / TLS
# Absolute paths keep runtime secrets, certificates, and backups outside the Git checkout.
PRODUCTION_RUNTIME_DIR=/opt/firewall-manager/runtime
PRODUCTION_BACKUP_DIR=/opt/firewall-manager/backups

# PRODUCTION SAFETY
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
