{
  "name": "firewall-manager-frontend",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:cdp": "node e2e/cdp-release-candidate.mjs",
    "e2e:cdp:routes": "node e2e/cdp-route-smoke.mjs",
    "e2e:cdp:app": "node e2e/cdp-application-sweep.mjs",
    "e2e:cdp:coverage": "node e2e/cdp-coverage.mjs",
    "e2e:cdp:functions": "node e2e/cdp-function-smoke.mjs",
    "e2e:cdp:faults": "node e2e/cdp-fault-smoke.mjs",
    "e2e:cdp:fixture": "node e2e/cdp-fixture-setup.mjs",
    "docs:screenshots": "node e2e/docs-screenshots.mjs",
    "api:generate": "openapi-typescript ../openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@mantine/core": "8.3.1",
    "@mantine/hooks": "8.3.1",
    "@tabler/icons-react": "^3.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12"
  }
}
