# Safe local-development defaults. Do not place production credentials in this file.
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
POSTGRES_DB=firewall_manager
POSTGRES_USER=firewall
POSTGRES_PASSWORD=firewall-local-only
DATABASE_URL=postgresql+psycopg://firewall:firewall-local-only@db:5432/firewall_manager
REDIS_URL=redis://redis:6379/0
FMC_BASE_URL=http://mock-fmc:9000
SCC_BASE_URL=http://mock-scc:9000
CORS_ORIGINS=["http://localhost:5173"]
DEV_AUTH_ENABLED=true
DEV_AUTH_DEFAULT_USER=viewer@example.test
# Generate locally before creating real provider connections:
# python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Production must inject this from a secrets manager; never commit a real value.
APP_SECRET_KEY=
SECRET_STORE_KEY_VERSION=1
SCHEDULER_INTERVAL_SECONDS=15
APP_PUBLIC_URL=http://localhost:5173
# Optional SMTP approval notifications. Leave SMTP_HOST and SMTP_FROM empty to disable delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
VITE_API_PROXY_TARGET=http://backend:8000
VITE_DEV_AUTH_USER=viewer@example.test
