# Safe local-development defaults. Do not place production credentials in this file.
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
POSTGRES_DB=firewall_manager
POSTGRES_USER=firewall
POSTGRES_PASSWORD=firewall-local-only
DATABASE_URL=postgresql+psycopg://firewall:firewall-local-only@db:5432/firewall_manager
REDIS_URL=redis://redis:6379/0
FMC_BASE_URL=http://mock-fmc:9000
SCC_BASE_URL=http://mock-scc:9000
CORS_ORIGINS=["http://localhost:5173"]
DEV_AUTH_ENABLED=true
DEV_AUTH_DEFAULT_USER=viewer@example.test
# Generate locally before creating real provider connections:
# python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Production must inject this from a secrets manager; never commit a real value.
APP_SECRET_KEY=
SECRET_STORE_KEY_VERSION=1
# Use vault in staging/production to resolve APP_SECRET_KEY from HashiCorp Vault KV v2.
SECRET_STORE_PROVIDER=environment
VAULT_URL=
VAULT_TOKEN=
VAULT_SECRET_PATH=secret/data/firewall-manager
SCHEDULER_INTERVAL_SECONDS=15
APP_PUBLIC_URL=http://localhost:5173
# Production: JSON array of deployment-owned OIDC relying-party profiles. Client secrets belong
# in the deployment secret manager; do not commit them. Entra uses a tenant issuer, Duo uses the
# Duo SSO OIDC issuer, and generic supports standards-compliant providers such as Okta.
OIDC_PROVIDERS=[]
AUTH_SESSION_IDLE_MINUTES=60
AUTH_SESSION_ABSOLUTE_HOURS=12
# One-time trusted-environment bootstrap only; remove after running
# python -m firewall_manager.bootstrap_admin
BOOTSTRAP_ORGANIZATION_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_ISSUER=
BOOTSTRAP_ADMIN_SUBJECT=
# Optional SMTP approval notifications. Leave SMTP_HOST and SMTP_FROM empty to disable delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
VITE_API_PROXY_TARGET=http://backend:8000
VITE_DEV_AUTH_USER=viewer@example.test
